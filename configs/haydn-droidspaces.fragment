# Kernel configurations for full DroidSpaces support (GKI, haydn 5.4)
# Based on official Droidspaces GKI documentation:
# https://www.droidspaces.org/docs/kernel-configuration.html
# Reference project: quilluna/android_kernel_oneplus_sm8350_ds (OnePlus 9, sm8350, 5.4.302)
#
# IMPORTANT: GKI kernels keep a fixed ABI. Only enable ABI-safe options.
# CONFIG_CFS_BANDWIDTH and CONFIG_CGROUP_PIDS BREAK kABI - NEVER enable them.
# CONFIG_CGROUP_NET_PRIO also caused "struct cgroup has no member id" on haydn 5.4.

# --- IPC mechanisms (MUST HAVE) ---
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y

# --- Core namespace support (MUST HAVE) ---
CONFIG_NAMESPACES=y
CONFIG_PID_NS=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y

# --- Seccomp support (MUST HAVE) ---
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y

# --- Device filesystem support (RECOMMENDED for hardware access) ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
